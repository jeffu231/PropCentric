<Window x:Class="Props.Runtime.Wizards.Features.Color.Views.ColorPickerDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:catel="http://schemas.catelproject.com"
        xmlns:local="clr-namespace:Props.Runtime.Wizards.Features.Color.Views"
        Title="Color Picker"
        Width="720"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundDialogBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Props.WPFCommon;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:DrawingColorToBrushConverter x:Key="DrawingColorToBrushConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Width="240"
                    Height="240"
                    BorderBrush="Silver"
                    BorderThickness="1">
                <Canvas x:Name="SpectrumSurface"
                        Width="240"
                        Height="240"
                        Background="White"
                        MouseLeftButtonDown="SpectrumSurface_OnMouseLeftButtonDown"
                        MouseMove="SpectrumSurface_OnMouseMove"
                        MouseLeftButtonUp="SpectrumSurface_OnMouseLeftButtonUp">
                    <Rectangle Width="240" Height="240">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFFF0000" Offset="0.0" />
                                <GradientStop Color="#FFFFFF00" Offset="0.17" />
                                <GradientStop Color="#FF00FF00" Offset="0.33" />
                                <GradientStop Color="#FF00FFFF" Offset="0.50" />
                                <GradientStop Color="#FF0000FF" Offset="0.67" />
                                <GradientStop Color="#FFFF00FF" Offset="0.83" />
                                <GradientStop Color="#FFFF0000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="240" Height="240">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse Width="12"
                             Height="12"
                             Stroke="Black"
                             StrokeThickness="2"
                             Fill="Transparent"
                             Canvas.Left="{Binding SpectrumSelectorX}"
                             Canvas.Top="{Binding SpectrumSelectorY}" />
                    <Ellipse Width="12"
                             Height="12"
                             Stroke="White"
                             StrokeThickness="1"
                             Fill="Transparent"
                             Canvas.Left="{Binding SpectrumSelectorX}"
                             Canvas.Top="{Binding SpectrumSelectorY}" />
                </Canvas>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="Quick Colors"
                       Margin="0,12,0,8"
                       FontWeight="SemiBold" />

            <StackPanel Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="48"
                                    Height="28"
                                    Margin="0,0,8,0"
                                    ToolTip="{Binding Name}"
                                    Tag="{Binding}"
                                    Click="PresetButton_OnClick">
                                <Rectangle Fill="{Binding Color, Converter={StaticResource DrawingColorToBrushConverter}}"
                                           Stroke="Black"
                                           StrokeThickness="1" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="Silver"
                            BorderThickness="1"
                            Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle Fill="{Binding OriginalBrush}" Height="68" />
                            <TextBlock Grid.Row="1"
                                       Padding="8,6"
                                       HorizontalAlignment="Center"
                                       Text="{Binding OriginalHex}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            BorderBrush="Silver"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Rectangle Fill="{Binding SelectedBrush}" Height="68" />
                            <TextBlock Grid.Row="1"
                                       Padding="8,6"
                                       HorizontalAlignment="Center"
                                       Text="{Binding SelectedHex}" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="HSV">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="H" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Hue, UpdateSourceTrigger=PropertyChanged}">
                        <b:Interaction.Behaviors>
                            <catel:NumericTextBox />
                        </b:Interaction.Behaviors>
                    </TextBox>

                    <TextBlock Grid.Row="1" Text="S" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Saturation, UpdateSourceTrigger=PropertyChanged}">
                        <b:Interaction.Behaviors>
                            <catel:NumericTextBox />
                        </b:Interaction.Behaviors>
                    </TextBox>

                    <TextBlock Grid.Row="2" Text="V" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                        <b:Interaction.Behaviors>
                            <catel:NumericTextBox />
                        </b:Interaction.Behaviors>
                    </TextBox>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="RGB">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="R" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Red, UpdateSourceTrigger=PropertyChanged}">
                        <b:Interaction.Behaviors>
                            <catel:NumericTextBox />
                        </b:Interaction.Behaviors>
                    </TextBox>

                    <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Green, UpdateSourceTrigger=PropertyChanged}">
                        <b:Interaction.Behaviors>
                            <catel:NumericTextBox />
                        </b:Interaction.Behaviors>
                    </TextBox>

                    <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Blue, UpdateSourceTrigger=PropertyChanged}">
                        <b:Interaction.Behaviors>
                            <catel:NumericTextBox />
                        </b:Interaction.Behaviors>
                    </TextBox>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Width="90"
                    Margin="0,0,8,0"
                    Content="OK"
                    IsDefault="True"
                    Click="OkButton_OnClick" />
            <Button Width="90"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
