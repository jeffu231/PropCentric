<catel:UserControl x:Class="Props.Runtime.Wizards.Features.Color.Views.ColorFeatureWizardPageView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:catel="http://schemas.catelproject.com"
                   xmlns:feature="clr-namespace:Props.Abstractions.Features;assembly=Props.Abstractions"
                   xmlns:local="clr-namespace:Props.Runtime.Wizards.Features.Color.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Props.WPFCommon;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:DrawingColorToBrushConverter x:Key="DrawingColorToBrushConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDialogBrush}" Margin="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Light Type"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <ComboBox Grid.Column="1"
                              SelectedValue="{Binding LightType, Mode=TwoWay}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Single Color" Tag="{x:Static feature:LightType.SingleColor}" />
                        <ComboBoxItem Content="Multiple Discrete Colors" Tag="{x:Static feature:LightType.MultipleDiscreteColors}" />
                        <ComboBoxItem Content="Full Color" Tag="{x:Static feature:LightType.FullColor}" />
                    </ComboBox>
                </Grid>

                <Border BorderBrush="Silver"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Single Color"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding IsSingleColorMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Grid Visibility="{Binding IsSingleColorMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="96"
                                    Height="32"
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    Background="{Binding SingleColor, Converter={StaticResource DrawingColorToBrushConverter}}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Text="{Binding SingleColorHex}" />
                            <Button Grid.Column="2"
                                    Width="96"
                                    Content="Pick Color"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type catel:UserControl}}, Path=ViewModel.PickSingleColorCommand}" />
                        </Grid>

                        <StackPanel Visibility="{Binding IsMultipleDiscreteColorsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Multiple Discrete Colors"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Selected Set"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding AvailableDiscreteColorSets}"
                                          SelectedItem="{Binding SelectedDiscreteColorSet, Mode=TwoWay}" />
                            </Grid>

                            <DataGrid ItemsSource="{Binding WorkingDiscreteColors}"
                                      SelectedItem="{Binding SelectedWorkingDiscreteColor, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" IsReadOnly="True" Width="Auto" />
                                    <DataGridTemplateColumn Header="Color" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="56"
                                                        Height="20"
                                                        BorderBrush="Black"
                                                        BorderThickness="1"
                                                        Background="{Binding Color, Converter={StaticResource DrawingColorToBrushConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Hex" Binding="{Binding Hex}" IsReadOnly="True" Width="*" />
                                    <DataGridTemplateColumn Header="Edit" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Edit"
                                                        Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type catel:UserControl}}, Path=ViewModel.EditWorkingDiscreteColorCommand}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Width="96"
                                        Margin="0,0,8,0"
                                        Content="Add Color"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type catel:UserControl}}, Path=ViewModel.AddWorkingDiscreteColorCommand}" />
                                <Button Width="112"
                                        Content="Remove Color"
                                        IsEnabled="{Binding CanRemoveWorkingDiscreteColor}"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type catel:UserControl}}, Path=ViewModel.RemoveWorkingDiscreteColorCommand}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Margin="0,0,8,0"
                                         Text="{Binding NewDiscreteColorSetName, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Width="120"
                                        Content="Save Custom Set"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type catel:UserControl}}, Path=ViewModel.SaveCustomSetCommand}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsFullColorMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Full Color"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Channel Order"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding AvailableFullColorOrders}"
                                          SelectedItem="{Binding SelectedFullColorOrder, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</catel:UserControl>
