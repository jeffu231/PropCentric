<views:WizardPageViewBase x:Class="Props.Runtime.Wizards.Features.Rotation.Views.RotationFeatureWizardPageView"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
                          xmlns:views="clr-namespace:Props.Runtime.Wizards.Core.Views"
                          xmlns:controls="clr-namespace:Common.WPFCommon.Controls;assembly=WPFCommon"
                          Loaded="PropWizardPageView_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Props.WPFCommon;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDialogBrush}" Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rotations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ComboBox MinWidth="40"
                                              Height="20"
                                              ItemsSource="{Binding Axes}"
                                              SelectedItem="{Binding Axis, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding RotationAngle, StringFormat=' {0:F0}&#176;'}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </StackPanel>

                                <controls:SuperSlider Grid.Column="1"
                                                      Minimum="-180"
                                                      Maximum="180"
                                                      DefaultValue="{Binding RotationAngleDefault}"
                                                      Value="{Binding RotationAngle, Mode=TwoWay}"
                                                      AutoToolTipPlacement="TopLeft" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding RotationSummary}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1"
                Width="400"
                Height="400"
                Margin="9,0,0,0"
                VerticalAlignment="Top"
                Background="Black"
                BorderBrush="Silver"
                BorderThickness="2">
            <glWpfControl:GLWpfControl x:Name="OpenTkControl"
                                       Render="OpenTkControl_OnRender"
                                       SizeChanged="OpenTkControl_SizeChanged"
                                       MouseWheel="OpenTkControl_MouseWheel"
                                       MouseDown="OpenTkControl_MouseDown"
                                       MouseMove="OpenTkControl_MouseMove"
                                       MouseUp="OpenTkControl_MouseUp">
                <glWpfControl:GLWpfControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rotation Preview" IsEnabled="False" />
                    </ContextMenu>
                </glWpfControl:GLWpfControl.ContextMenu>
            </glWpfControl:GLWpfControl>
        </Border>
    </Grid>
</views:WizardPageViewBase>
