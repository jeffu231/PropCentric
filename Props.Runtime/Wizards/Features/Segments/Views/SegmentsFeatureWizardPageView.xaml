<catel:UserControl x:Class="Props.Runtime.Wizards.Features.Segments.Views.SegmentsFeatureWizardPageView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:catel="http://schemas.catelproject.com">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Props.WPFCommon;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDialogBrush}" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Segments}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Start" Binding="{Binding StartDisplay}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="End" Binding="{Binding EndDisplay}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Point Count" Binding="{Binding PointCount, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Text="Total Points: " FontWeight="SemiBold" />
            <TextBlock Text="{Binding TotalPoints}" />
        </StackPanel>
    </Grid>
</catel:UserControl>
